# Copy to .env and fill in. Never commit .env.

# --- LLM (required for the agent; without it the API falls back to the rules baseline) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# USD per million tokens for the cost metric. Check https://www.anthropic.com/pricing
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0

# --- Threat intel (optional; without keys the tools use data/intel_fixtures.json) ---
# Free keys: https://www.abuseipdb.com/register  and  https://www.virustotal.com/gui/join-us
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
# auto | fixtures | live
INTEL_MODE=auto

# --- Agent behavior ---
REVIEW_CONFIDENCE_THRESHOLD=0.6
MAX_TOOL_ROUNDS=4
# auto | llm | baseline
TRIAGE_ENGINE=auto
# auto | sentence-transformers | tfidf
EMBEDDING_BACKEND=auto

# --- Database (docker-compose sets this for you) ---
# DATABASE_URL=postgresql://triage:triage@localhost:5432/triage

# --- Optional: LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-alert-triage
